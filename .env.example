# HARZ Cloud Backend Environment Variables

# Server
PORT=3000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-here

# Base44 Integration (optional — for entity sync)
BASE44_API_URL=https://api.base44.com
BASE44_APP_ID=6a719fef48fad9154718941d
BASE44_API_KEY=your-base44-api-key

# Payment Integration (future)
PAYSTACK_SECRET_KEY=your-paystack-secret
STRIPE_SECRET_KEY=your-stripe-secret

# GitHub (for DeployForge integration)
GITHUB_TOKEN=your-github-token
